# /etc/udev/rules.d/99-roombabot.rules
#
# Stable names for the three USB devices. Without these the kernel hands out
# /dev/ttyUSB0..2 in enumeration order, which is not stable across boots -- and a swap
# would send wheel velocity commands to the IMU board.
#
# Reference copy only: the live rules already exist on the Pi. Kept in the repo so the
# names the launch files depend on are written down somewhere, and so reflashing the Pi
# does not mean rediscovering them.
#
# Find the attributes for a specific device with:
#   udevadm info -a -n /dev/ttyUSB0 | head -40
#
# Two ESP32s with the same USB-serial bridge chip will share idVendor/idProduct, so
# they must be told apart by serial number (ATTRS{serial}) or, failing that, by the
# physical port they are plugged into (KERNELS=="1-1.2" etc). Fill in the values from
# udevadm for this robot's actual boards.
#
# After editing:
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   ls -l /dev/esp32_motor /dev/esp32_imu /dev/rplidar

# ESP32 running the motor controllers + encoders
SUBSYSTEM=="tty", ATTRS{idVendor}=="XXXX", ATTRS{idProduct}=="XXXX", ATTRS{serial}=="REPLACE_WITH_MOTOR_ESP_SERIAL", SYMLINK+="esp32_motor", MODE="0666"

# ESP32 reading the MPU6050
SUBSYSTEM=="tty", ATTRS{idVendor}=="XXXX", ATTRS{idProduct}=="XXXX", ATTRS{serial}=="REPLACE_WITH_IMU_ESP_SERIAL", SYMLINK+="esp32_imu", MODE="0666"

# Slamtec RPLIDAR A1 (CP2102 bridge)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="rplidar", MODE="0666"

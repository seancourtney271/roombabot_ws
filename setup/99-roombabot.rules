# /etc/udev/rules.d/99-roombabot.rules  (installed on the Pi as 99-usb-devices.rules)
#
# Stable names for the three USB devices. Without these the kernel hands out
# /dev/ttyUSB0..2 in enumeration order, which is not stable across boots -- and a swap
# would send wheel velocity commands to the IMU board.
#
# All three devices are CP2102 bridges (10c4:ea60) that report the SAME serial number
# ("0001"), so they cannot be told apart by any device attribute. These rules key on
# the physical USB port instead (ATTRS{devpath}): each device must stay plugged into
# its own port. Moving a cable swaps the names -- the motor and IMU boards were found
# swapped this way on 2026-10-11.
#
# Find a device's port with:
#   udevadm info -q property -n /dev/ttyUSB0 | grep ID_PATH=   # ...-usb-0:1.3:1.0 -> "1.3"
#
# After editing:
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   ls -l /dev/esp32_motor /dev/esp32_imu /dev/rplidar

# ESP32 running the motor controllers + encoders (USB 2.0 port)
KERNEL=="ttyUSB*", ATTRS{devpath}=="1.3", SYMLINK+="esp32_motor", MODE:="0666"

# ESP32 reading the MPU6050 (USB 2.0 port)
KERNEL=="ttyUSB*", ATTRS{devpath}=="1.4", SYMLINK+="esp32_imu", MODE:="0666"

# Slamtec RPLIDAR A1 (USB 3.0 port)
KERNEL=="ttyUSB*", ATTRS{devpath}=="1.2", SYMLINK+="rplidar", MODE:="0666"

<?xml version="1.0" ?>
<!-- Small single-storey house, 10 m x 8 m, for testing SLAM / AMCL / Nav2.
     Generated layout; the robot spawns at the origin in the living room.

       y=4 +===========+========+===========+
           | bedroom   |  bath  |  office   |
       y=1 +===  ======+=  =====+====  =====+
           |                    :           |
           |  living room   (0,0)  kitchen  |
           |                    :           |
      y=-4 +====================+===========+
          x=-4                 x=2         x=6

     Furniture is sized so the 0.122 m lidar plane sees it. Tables and chairs
     are legged, so only their legs appear in the scan. -->
<sdf version="1.7">
  <world name="small_house">
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.75 0.68 0.55 1</ambient><diffuse>0.75 0.68 0.55 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="wall_0">
        <pose>1.000 -4.000 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.100 0.100 1.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.100 0.100 1.000</size></box></geometry><material><ambient>0.85 0.82 0.75 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
      <link name="wall_1">
        <pose>1.000 4.000 0.500 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.100 0.100 1.000</size></box></geometry></collision>
